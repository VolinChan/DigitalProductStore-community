# Digital Store - Environment Configuration
# Copy this file to .env and update values for your environment

# Application
APP_ENV=development
SEED_DEMO_DATA=false

# Database
DB_USER=postgres
DB_PASSWORD=change-me-locally
DB_NAME=digital_store

# Authentication
JWT_SECRET=change-me-to-a-secure-random-string

# Frontend
NEXT_PUBLIC_API_URL=https://www.plexoria.cl/
NEXT_PUBLIC_GRAFANA_URL=https://grafana.plexoria.cl
# Keep the admin link hidden until Grafana DNS, TLS, and authentication are verified in the target environment.
NEXT_PUBLIC_SYSTEM_MONITORING_LINK_ENABLED=false
INTERNAL_API_BASE_URL=http://api:8080
SITE_URL=https://www.plexoria.cl
FRONTEND_URL=https://www.plexoria.cl
SEO_INDEXING_ENABLED=false
SEO_REVALIDATE_SECONDS=900
SEO_REVALIDATION_URL=http://frontend:3000/api/revalidate/catalog
SEO_REVALIDATION_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_CATALOG_EDITOR_ENABLED=true
NEXT_PUBLIC_CATALOG_STOREFRONT_ENABLED=true
# Manual bank-transfer defaults, read by the API at runtime. Values saved in
# the super-admin console override them. Do not use NEXT_PUBLIC_* for this.
TRANSFER_BANK_NAME=
TRANSFER_ACCOUNT_NAME=
TRANSFER_ACCOUNT_NUMBER=

# Catalog media limits (bytes/count)
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_MAX_VIDEOS_PER_PRODUCT=3
MEDIA_MAX_PER_PRODUCT=100
MEDIA_UPLOAD_CONCURRENCY=3

# Supported in every environment: local, s3, minio, or r2. When local is used
# in production, persist and back up the uploads Docker volume or host path.
STORAGE_PROVIDER=local

# Transactional email. For Resend, verify the sending domain first and use an
# address on that domain for EMAIL_FROM_ADDRESS.
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM_NAME=PLEXORIA
EMAIL_FROM_ADDRESS=notifications@your-verified-domain.example
EMAIL_BRAND_NAME=PLEXORIA
EMAIL_PASSWORD_RESET_URL=https://www.plexoria.cl/es-CL/reset-password
EMAIL_REPLY_TO=support@your-domain.example
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_API_ENDPOINT=https://api.resend.com/emails

# SMTP fallback (unused when EMAIL_PROVIDER=resend)
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://www.plexoria.cl/es-CL/checkout/success
STRIPE_CANCEL_URL=https://www.plexoria.cl/es-CL/checkout/payment
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-locally
POSTGRES_EXPORTER_PASSWORD=replace-with-a-monitoring-only-password
ALERTMANAGER_RECEIVER_SECRET_FILE=./monitoring/alertmanager/receiver_url.example

# Backup
BACKUP_RETAIN_DAYS=30
REMOTE_BACKUP_PATH=s3://your-bucket/backups
