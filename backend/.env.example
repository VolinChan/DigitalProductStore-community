# Application
APP_ENV=development

# Server
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=digital_store
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_TOKEN_TTL=24h
JWT_REFRESH_TOKEN_TTL=168h
JWT_ISSUER=digital-store

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
EMAIL_FROM_NAME=Digital Store
EMAIL_FROM_ADDRESS=noreply@digitalstore.com
EMAIL_BRAND_NAME=
EMAIL_PASSWORD_RESET_URL=
# Set EMAIL_ENABLED=true to turn on real SMTP delivery. When false (the
# default) a no-op sender is used, which is safe for local dev and CI.
EMAIL_ENABLED=false

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Payment - Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payment - PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BLOCK_DURATION=1m
