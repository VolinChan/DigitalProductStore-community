# Digital Store - Environment Configuration
# Copy this file to .env and update values for your environment

# Application
APP_ENV=development

# Database
DB_USER=postgres
DB_PASSWORD=change-me-locally
DB_NAME=digital_store

# Authentication
JWT_SECRET=change-me-to-a-secure-random-string

# Frontend
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-locally

# Backup
BACKUP_RETAIN_DAYS=30
REMOTE_BACKUP_PATH=s3://your-bucket/backups
