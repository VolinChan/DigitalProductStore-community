# Digital Store Database Backup Schedule
# Install with: crontab scripts/crontab

# Daily full backup at 2:00 AM
0 2 * * * /app/scripts/backup.sh full >> /var/log/backup-full.log 2>&1

# Incremental backup every 6 hours (at 8:00, 14:00, 20:00)
0 8,14,20 * * * /app/scripts/backup.sh incr >> /var/log/backup-incr.log 2>&1

# Cleanup old backups weekly on Sunday at 3:00 AM
0 3 * * 0 /app/scripts/backup.sh cleanup >> /var/log/backup-cleanup.log 2>&1
