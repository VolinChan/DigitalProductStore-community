        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "id": 3,
      "title": "Request Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"digital-store-api\"}[5m]))",
          "legendFormat": "req/s"
        }
      ]
