            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "title": "API Status",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=\"digital-store-api\"}",
          "legendFormat": "API"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
