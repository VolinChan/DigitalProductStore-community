        {
          "expr": "sum(rate(http_requests_total{job=\"digital-store-api\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"digital-store-api\"}[5m])) * 100",
          "legendFormat": "errors"
        }
      ]
    },
    {
